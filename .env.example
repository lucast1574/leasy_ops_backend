# Django Core Settings
DEBUG=False
SECRET_KEY=django-insecure-leasy-ops-app-default-key-replace-me
ALLOWED_HOSTS=localhost,127.0.0.1,.leasyauto.com,.floty.mx

# Database Settings
# For PostgreSQL: postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///db.sqlite3

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.leasyauto.com
DJANGO_LOG_LEVEL=INFO

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_AUTH_ALLOWED_DOMAINS=leasyauto.com,floty.mx

# App Info
SPECTACULAR_TITLE="Leasy Ops API"
SPECTACULAR_VERSION="1.0.0"
