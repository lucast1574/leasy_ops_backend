# Git
.git/
.gitignore
.github/

# Virtual Environments
venv/
env/
ENV/
.venv/
test_venv/

# Environment Variables (NEVER copy secrets into the image)
.env
.env.local
.env.prod

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# Local SQLite DB (prod uses Postgres via DATABASE_URL)
*.sqlite3
db.sqlite3

# Static files — regenerated by collectstatic inside the container
staticfiles/

# Docker itself
Dockerfile
.dockerignore

# Editor / OS noise
.vscode/
.idea/
.DS_Store
*.swp

# Docs & CI config not needed in runtime image
README.md
*.md
